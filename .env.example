# Public DNS names pointing to this Docker host
NOVELLA_HOST=novella.example.com
AUTHENTIK_HOST=auth.example.com

# Used by Let's Encrypt for certificate notices
ACME_EMAIL=you@example.com

# Generate with: openssl rand -base64 36 | tr -d '\n'
PG_PASS=replace-with-a-random-postgres-password

# Generate with: openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=replace-with-a-random-authentik-secret

# Temporary dual-login bridge. Generate each value independently with:
# openssl rand -base64 48 | tr -d '\n'
SESSION_SECRET=replace-with-a-random-session-signing-secret
AUTH_PROXY_SECRET=replace-with-a-random-proxy-assertion-secret
AUTH_REQUIRED=true
AUTHENTIK_LOGIN_ENABLED=true

# Emergency rollback: set this to authentik@docker,security-headers@docker
# together with AUTH_REQUIRED=false to restore the previous proxy-only gate.
NOVELLA_MIDDLEWARES=security-headers@docker

# Pinned so upgrades are deliberate
AUTHENTIK_TAG=2026.5.3
AUTHENTIK_LOG_LEVEL=info

# Optional scene narration. Keep the API key only in .env on the server.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# false requests zero-retention mode from ElevenLabs.
ELEVENLABS_ENABLE_LOGGING=false

# Microsoft Entra ID application credentials. Keep the client secret only in .env.
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-application-client-id
ENTRA_CLIENT_SECRET=your-client-secret
ENTRA_REDIRECT_URI=https://novella.neoscion.com/auth/entra/callback
ENTRA_POST_LOGOUT_REDIRECT_URI=https://novella.neoscion.com/
