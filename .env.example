# Sign application sessions. Generate with:
# openssl rand -base64 48 | tr -d '\n'
SESSION_SECRET=replace-with-a-random-session-signing-secret
AUTH_REQUIRED=true
DATABASE_FILE=/app/data/novella.sqlite

# Numeric runtime identity for the Novella container. The 1000:1000 defaults
# are for local development only. In production, use `id -u novella` and
# `id -g novella` from the dedicated host service account.
NOVELLA_UID=1000
NOVELLA_GID=1000

# Optional scene narration. Keep the API key only in .env on the server.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# false requests zero-retention mode from ElevenLabs.
ELEVENLABS_ENABLE_LOGGING=false

# Private, self-hosted proofreading. This URL must remain server-side and point
# to the non-published LanguageTool service on the internal Compose network.
PROOFREADING_ENABLED=true
PROOFREADING_URL=http://languagetool:8010
PROOFREADING_TIMEOUT_MS=8000
PROOFREADING_LANGUAGE=en-US
PROOFREADING_MAX_CONCURRENT=2
LANGUAGETOOL_JAVA_XMS=256m
LANGUAGETOOL_JAVA_XMX=512m
LANGUAGETOOL_MEMORY_LIMIT=768m
LANGUAGETOOL_CPU_LIMIT=1.0

# Microsoft Entra ID application credentials. Keep the client secret only in .env.
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-application-client-id
ENTRA_CLIENT_SECRET=your-client-secret
ENTRA_REDIRECT_URI=https://novella.neoscion.com/auth/entra/callback
ENTRA_POST_LOGOUT_REDIRECT_URI=https://novella.neoscion.com/
