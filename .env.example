# Public DNS name pointing to this Docker host
NOVELLA_HOST=novella.example.com

# Used by Let's Encrypt for certificate notices
ACME_EMAIL=you@example.com

# Sign application sessions. Generate with:
# openssl rand -base64 48 | tr -d '\n'
SESSION_SECRET=replace-with-a-random-session-signing-secret
AUTH_REQUIRED=true
DATABASE_FILE=/app/data/novella.sqlite

# Optional scene narration. Keep the API key only in .env on the server.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# false requests zero-retention mode from ElevenLabs.
ELEVENLABS_ENABLE_LOGGING=false

# Microsoft Entra ID application credentials. Keep the client secret only in .env.
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-application-client-id
ENTRA_CLIENT_SECRET=your-client-secret
ENTRA_REDIRECT_URI=https://novella.neoscion.com/auth/entra/callback
ENTRA_POST_LOGOUT_REDIRECT_URI=https://novella.neoscion.com/
